<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ErenshorModInstaller.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Erenshor Mod Installer"
        Height="800" Width="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        WindowStyle="None"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <wc:WindowChrome.WindowChrome>
    <wc:WindowChrome
        CaptionHeight="0"
        CornerRadius="16"
        GlassFrameThickness="1"
        ResizeBorderThickness="8"
        UseAeroCaptionButtons="False"/>
  </wc:WindowChrome.WindowChrome>

  <!-- Drop Shadow Effect + Glass Border -->
  <Border CornerRadius="0" Background="{StaticResource WindowBg}" BorderBrush="#3D4049" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="0,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderColor}"
              MouseDown="TitleBar_MouseDown">
        <Grid wc:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Image Source="/Assets/appicon.ico" Width="20" Height="20" Margin="0,0,8,0" 
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Erenshor Mod Manager" FontSize="13" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AppVersion}" FontSize="11" 
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource TitleBarButton}" Content="―" Click="Minimize_Click" ToolTip="Minimize"/>
            <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click" ToolTip="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main Content -->
      <Grid Grid.Row="1" Margin="24,24,24,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Sidebar Actions -->
          <Border Grid.Column="0" Background="{StaticResource SidebarBg}" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderColor}">
            <StackPanel>
              <!-- Game Selection -->
              <TextBlock Text="Game Installation" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
              <ComboBox x:Name="GamePathComboBox" 
                        Style="{StaticResource ModernComboBox}"
                        Margin="0,8,0,0"
                        Height="Auto"
                        MinHeight="36"
                        DisplayMemberPath="Label"
                        SelectionChanged="GamePathComboBox_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItem}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                          <Border Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Padding="{TemplateBinding Padding}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              
                              <TextBlock Text="{Binding Label}" 
                                         VerticalAlignment="Center"
                                         Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                              
                              <!-- Browse button - only in dropdown -->
                              <Button Grid.Column="1" 
                                      Content="📁"
                                      Margin="8,0,0,0"
                                      Padding="6,2"
                                      FontSize="12"
                                      Style="{StaticResource SecondaryButton}"
                                      Click="BrowseGamePath_Click"
                                      Tag="{Binding}"
                                      ToolTip="Browse for game folder"
                                      Visibility="{Binding ShowBrowseButton}"/>
                            </Grid>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>

              <!-- Divider -->
              <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,20,0,20"/>

              <!-- Global Mod Control -->
              <TextBlock Text="Global Control" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
              <TextBlock Text="Enable or disable all mods" 
                         TextWrapping="Wrap" 
                         Foreground="{StaticResource TextSecondary}"
                         FontSize="12"
                         Margin="0,6,0,12"/>
              
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="EnableAllButton" 
                        Content="✓ ON" 
                        Style="{StaticResource SecondaryButton}"
                        Click="EnableAllMods_Click"
                        ToolTip="Enable all mods"/>
                
                <Button x:Name="DisableAllButton"
                        Grid.Column="2"
                        Content="✕ OFF" 
                        Style="{StaticResource SecondaryButton}"
                        Click="DisableAllMods_Click"
                        ToolTip="Disable all mods"/>
              </Grid>

              <!-- Divider -->
              <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,20,0,20"/>

              <!-- Install Section -->
              <TextBlock Text="Install Mod" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
              <TextBlock Text="Drop a .zip file anywhere in this window" 
                         TextWrapping="Wrap" 
                         Foreground="{StaticResource TextSecondary}"
                         FontSize="12"
                         Margin="0,8,0,16"/>
              <Button Content="📦 Choose File" 
                      Style="{StaticResource PrimaryButton}" 
                      HorizontalAlignment="Stretch"
                      Click="InstallZip_Click"/>

              <!-- Divider -->
              <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,24,0,24"/>

              <!-- Manage Section -->
              <TextBlock Text="Manage" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
              <Button Content="Open Plugins" 
                      Style="{StaticResource SecondaryButton}" 
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8"
                      Click="OpenPlugins_Click"/>
              <Button Content="🔄 Refresh List" 
                      Style="{StaticResource SecondaryButton}" 
                      HorizontalAlignment="Stretch"
                      Click="RefreshMods_Click"/>
            </StackPanel>
          </Border>

          <!-- Mods List -->
          <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderColor}">
            <Grid Margin="20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <TextBlock Text="Installed Mods" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
              
              <TextBlock x:Name="StatusBlock" Grid.Row="2" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>

              <ListBox x:Name="ModsList" Grid.Row="4"
                       Style="{StaticResource ModernListBox}"
                       ItemsSource="{Binding Mods}"
                       PreviewMouseRightButtonDown="ModsList_PreviewMouseRightButtonDown"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}" 
                                   FontWeight="Medium"
                                   FontSize="15"
                                   Foreground="{StaticResource TextPrimary}"
                                   ToolTip="{Binding Guid}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding StatusSuffix}" 
                                     Foreground="{StaticResource TextMuted}"
                                     FontSize="11"
                                     Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Version}" 
                                     Foreground="{StaticResource TextMuted}"
                                     FontSize="11"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Toggle Button -->
                      <Button Grid.Column="1"
                              Tag="{Binding}"
                              Click="ModToggle_Click"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0,0,4,0"
                              Margin="0,0,10,0"
                              Width="Auto"
                              Height="Auto">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                          </ControlTemplate>
                        </Button.Template>
                        <Button.ToolTip>
                          <ToolTip>
                            <TextBlock>
                              <Run Text="{Binding IsEnabled, Mode=OneWay, Converter={StaticResource BoolToToggleTextConverter}}"/>
                            </TextBlock>
                          </ToolTip>
                        </Button.ToolTip>
                        <Image Width="32" Height="32"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Style>
                            <Style TargetType="Image">
                              <Setter Property="Source" Value="/Assets/moddisabled.png"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                  <Setter Property="Source" Value="/Assets/modenabled.png"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </Button>

                      <!-- Uninstall Button -->
                      <Button Grid.Column="2"
                              Tag="{Binding}"
                              Click="ModUninstall_Click"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="Uninstall mod">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                          </ControlTemplate>
                        </Button.Template>
                        <Image Source="/Assets/uninstall.png"
                               Width="20" Height="20"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          
          <Button Grid.Column="1" 
                  Content="🚀 Launch Erenshor" 
                  Style="{StaticResource PrimaryButton}"
                  Padding="24,12"
                  FontSize="14"
                  Click="LaunchErenshor_Click"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
