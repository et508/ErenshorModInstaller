<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ErenshorModInstaller.Wpf.SaveProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Mod Profile"
        Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

  <Border Background="{StaticResource WindowBg}" 
          BorderBrush="{StaticResource BorderColor}" 
          BorderThickness="1" 
          CornerRadius="0">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
    </Border.Effect>

    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title -->
      <TextBlock Grid.Row="0" 
                 Text="Save Mod Profile" 
                 FontSize="18" 
                 FontWeight="SemiBold" 
                 Foreground="{StaticResource TextPrimary}"/>

      <!-- Profile Name -->
      <StackPanel Grid.Row="2">
        <TextBlock Text="Profile Name" 
                   FontSize="13" 
                   FontWeight="Medium" 
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="ProfileNameTextBox"
                 Style="{StaticResource ModernTextBox}"
                 Height="40"
                 FontSize="13"
                 MaxLength="50"/>
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                Content="Cancel"
                Style="{StaticResource SecondaryButton}"
                Width="100"
                Height="36"
                Margin="0,0,8,0"
                Click="Cancel_Click"/>

        <Button x:Name="SaveButton"
                Content="Save Profile"
                Style="{StaticResource PrimaryButton}"
                Width="120"
                Height="36"
                Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
