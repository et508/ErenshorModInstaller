<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ErenshorModInstaller.Wpf.ProfileManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Profiles"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

  <Border Background="{StaticResource WindowBg}" 
          BorderBrush="{StaticResource BorderColor}" 
          BorderThickness="1" 
          CornerRadius="0">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
    </Border.Effect>

    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title -->
      <TextBlock Grid.Row="0" 
                 Text="Manage Profiles" 
                 FontSize="18" 
                 FontWeight="SemiBold" 
                 Foreground="{StaticResource TextPrimary}"/>

      <!-- Profiles List -->
      <Border Grid.Row="2" 
              Background="{StaticResource SidebarBg}" 
              BorderBrush="{StaticResource BorderColor}" 
              BorderThickness="1" 
              CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ProfilesList" Padding="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource WindowBg}" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12" 
                        Margin="0,0,0,8">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="6"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="12"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Name -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding Name}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}"/>

                    <!-- Description -->
                    <TextBlock Grid.Row="2" 
                               Text="{Binding Description}" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondary}" 
                               TextWrapping="Wrap"
                               Visibility="{Binding HasDescription}"/>

                    <!-- Stats and Actions -->
                    <Grid Grid.Row="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <!-- Stats -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding ModCount}" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text=" mods • " 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding LastUsedText}" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMuted}"/>
                      </StackPanel>

                      <!-- Action Buttons -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="✎ Rename" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Click="Rename_Click"
                                Tag="{Binding}"/>
                        <Button Content="✕ Delete" 
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="11"
                                Click="Delete_Click"
                                Tag="{Binding}"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Empty State -->
      <StackPanel Grid.Row="2" 
                  x:Name="EmptyState"
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock Text="No profiles saved yet" 
                   FontSize="14" 
                   Foreground="{StaticResource TextSecondary}" 
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Create a profile from the main window" 
                   FontSize="12" 
                   Foreground="{StaticResource TextMuted}" 
                   HorizontalAlignment="Center" 
                   Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Close Button -->
      <Button Grid.Row="4"
              Content="Close"
              Style="{StaticResource PrimaryButton}"
              Width="120"
              Height="36"
              HorizontalAlignment="Right"
              Click="Close_Click"/>
    </Grid>
  </Border>
</Window>
